class Solution {
    boolean isPalindrome(String s) {
        int l = 0;
        int h = s.length() - 1;
        
        while (l < h) {
            if (s.charAt(l) != s.charAt(h)) {
                return false;
            } else {
                l++;
                h--;
            }
        }
        return true;
    }
}

