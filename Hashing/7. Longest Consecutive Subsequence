class Solution {
    public int longestConsecutive(int[] arr) {
        HashSet<Integer> set = new HashSet<>();
        
        for (int num : arr) {
            set.add(num);
        }
        
        int maxCount = 0;
        
        for (int num : set) {
            if (!set.contains(num - 1)) {
                int curr = num;
                int count = 1;
                
                while (set.contains(curr + 1)) {
                    curr++;
                    count++;
                }
                
                maxCount = Math.max(count, maxCount);
            }
        }
        return maxCount;
    }
}

