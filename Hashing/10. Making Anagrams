    public static int makingAnagrams(String s1, String s2) {
    // Write your code here
        int n1 = s1.length();
        int n2 = s2.length();
        int count = 0;
        
        Map<Character, Integer> map = new HashMap<>();
        
        for (int i = 0; i < n1; i++) {
            char ch = s1.charAt(i);
            map.put(ch, map.getOrDefault(ch, 0) + 1);
        }
        
        for (int i = 0; i < n2; i++) {
            char ch = s2.charAt(i);
            map.put(ch, map.getOrDefault(ch, 0) - 1);
        }
        
        for (int freq : map.values()) {
            count += Math.abs(freq);
        }
        
        return count;
    }

}

