class Solution {
    public int rob(int[] nums) {
        int n = nums.length;

        if (n == 1) {
            return nums[0];
        }

        int[] dp1 = new int[n + 1];
        int[] dp2 = new int[n];

        dp1[n] = 0;
        dp1[n - 1] = nums[n - 1];

        dp2[n - 1] = 0;
        dp2[n - 2] = nums[n - 2];

        for (int i = n - 2; i >= 0; i--) {
            int rob = nums[i] + dp1[i + 2];
            int skip = dp1[i + 1];
            dp1[i] = Math.max(rob, skip);
        }

        for (int i = n - 3; i >= 0; i--) {
            int rob = nums[i] + dp2[i + 2];
            int skip = dp2[i + 1];
            dp2[i] = Math.max(rob, skip);
        }

        return Math.max(dp1[1], dp2[0]);
    }
}

