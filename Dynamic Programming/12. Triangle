class Solution {
    public int minimumTotal(List<List<Integer>> triangle) {
        int n = triangle.size();
        int[][] dp = new int[n][n];
        boolean[][] visited = new boolean[n][n];
        
        return solve(triangle, 0, 0, dp, visited);
    }
    private int solve(List<List<Integer>> triangle, int i, int j, int[][] dp, boolean[][] visited) {
        int n = triangle.size();

        if (i == n - 1) {
            return triangle.get(i).get(j);
        }

        if (visited[i][j]) {
            return dp[i][j];
        }
        dp[i][j] = triangle.get(i).get(j) + Math.min(solve(triangle, i + 1, j, dp, visited), solve(triangle, i + 1, j + 1, dp, visited));
        visited[i][j] = true;

        return dp[i][j];
    }
}

