class Solution {
    int minCost(int[] height) {
       int n = height.length;
       
       int[] dp = new int[n];
       
       dp[n - 1] = 0;
       
       
       for (int i = n - 2; i >= 0; i--) {
           int jumpOne = Math.abs(height[i] - height[i + 1]) + dp[i + 1];
           
           int jumpTwo = Integer.MAX_VALUE;
           
           if (i + 2 < n) {
               jumpTwo = Math.abs(height[i] - height[i + 2]) + dp[i + 2];
           }
           
           dp[i] = Math.min(jumpOne, jumpTwo);
       }
       
       return dp[0];
    }
}



