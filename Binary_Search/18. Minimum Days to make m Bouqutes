class Solution {
    public int minDays(int[] bloomDay, int m, int k) {
        int n = bloomDay.length;

        if ((long) m * k > n) {
            return -1;
        }

        int start = minimum(bloomDay);
        int end = maximum(bloomDay);

        int ans = -1;

        while (start <= end) {
            int mid = start + (end - start) / 2;

            if (days(bloomDay, mid, k) >= m) {
                ans = mid;
                end = mid - 1;
            } else {
                start = mid + 1;
            }
        }
        return ans;
    }
    private int minimum(int[] bloomDay) {
        int n = bloomDay.length;

        int min = Integer.MAX_VALUE;

        for (int i = 0; i < n; i++) {
            min = Math.min(min, bloomDay[i]);
        }
        return min;
    }
    private int maximum(int[] bloomDay) {
        int n = bloomDay.length;

        int max = Integer.MIN_VALUE;

        for (int i = 0; i < n; i++) {
            max = Math.max(max, bloomDay[i]);
        }
        return max;
    }
    private int days(int[] bloomDay, int mid, int k) {
        int n = bloomDay.length;

        int count = 0;
        int consecutive = 0;

        for (int i = 0; i < n; i++) {
            if (bloomDay[i] <= mid) {
                consecutive++;
                
                if (consecutive == k) {
                    count++;
                    consecutive = 0;
                }
            } else {
                consecutive = 0;
            }
        }
        return count;
    }
}


