class Solution {
    public int findPeakElement(int[] nums) {
        int n = nums.length;

        int l = 0;
        int e = n - 1;

        while (l < e) {
            int mid = l + (e - l) / 2;

            if (nums[mid] > nums[mid + 1]) {
                e = mid;
            } else {
                l = mid + 1;
            }
        }
        return l;
    }
}

