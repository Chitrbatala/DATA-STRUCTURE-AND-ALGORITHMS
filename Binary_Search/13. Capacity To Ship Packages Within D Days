class Solution {
    public int shipWithinDays(int[] weights, int days) {
        int n = weights.length;
        int l = maximum(weights);
        int h = summation(weights);

        int ans = -1;

        while (l <= h) {
            int mid = l + (h - l) / 2;

            if (countDays(weights, mid) <= days) {
                ans = mid;
                h = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        return ans;
    }
    private int maximum(int[] weights) {
        int max = Integer.MIN_VALUE;

        for (int i = 0; i < weights.length; i++) {
            max = Math.max(max, weights[i]);
        }
        return max;
    }
    private int summation(int[] weights) {
        int sum = 0;

        for (int i = 0; i < weights.length; i++) {
            sum += weights[i];
        }

        return sum;
    }
    private int countDays(int[] weights, int mid) {
        int n = weights.length;

        int sum = 0;
        int count = 1;

        for (int i = 0; i < n; i++) {
            if (sum + weights[i] <= mid) {
                sum += weights[i];
            } else {
                count++;
                sum = weights[i];
            }
        }
        return count;
    }
}




