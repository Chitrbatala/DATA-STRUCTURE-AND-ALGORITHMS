class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int l = 1;
        int h = maxi(nums);

        int ans = -1;

        while (l <= h) {
            int mid = l + (h - l) / 2;

            if (sumOfDiv(nums, mid) <= threshold) {
                ans = mid;
                h = mid - 1;
            } else {
                l = mid + 1;
            }
        }
        return ans;
    }
    private int maxi(int[] nums) {
        int n= nums.length;
        int max = Integer.MIN_VALUE;

        for (int i = 0; i < n; i++) {
            max = Math.max(max, nums[i]);
        }
        return max;
    }

    private int sumOfDiv(int[] nums, int mid) {
        int n = nums.length;
        int sum = 0;
        
        for (int i = 0; i < n; i++) {
            sum += (nums[i] + mid - 1) / mid;
        }
        return sum;
    }
}

