class Solution {
    public int maxProduct(int[] nums) {
        int n = nums.length;

        int leftP = 1;
        int rightP = 1;
        int max = Integer.MIN_VALUE;

        for (int i = 0; i < n; i++) {
            leftP = (leftP == 0 ? 1 : leftP) * nums[i];
            rightP = (rightP == 0 ? 1 : rightP) * nums[n - 1 - i];

            max = Math.max(max, Math.max(leftP, rightP));
        }

        return max;
    }
}

