class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        backtrack(nums, new ArrayList<>(), new HashMap<>(), ans);
        return ans;
    }
    private void backtrack(int[] nums, List<Integer> curr, Map<Integer, Integer> map, List<List<Integer>> ans) {
        if (curr.size() == nums.length) {
            ans.add(new ArrayList<>(curr));
            return;
        }
        for (int i = 0; i < nums.length; i++) {
            if (!map.containsKey(i)) {
                curr.add(nums[i]);
                map.put(i, 1);

                backtrack(nums, curr, map, ans);
                curr.remove(curr.size() - 1);
                map.remove(i);
            }
        }
    }
}
