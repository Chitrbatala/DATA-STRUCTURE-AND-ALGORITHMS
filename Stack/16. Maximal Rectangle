class Solution {
    public int maximalRectangle(char[][] matrix) {
        if (matrix == null || matrix.length == 0)
            return 0;

        int row = matrix.length;
        int col = matrix[0].length;

        int[] arr = new int[col];
        int ans = 0;

        for (int i = 0; i < row; i++) {

            // Build histogram for current row
            for (int j = 0; j < col; j++) {
                if (matrix[i][j] == '0') {
                    arr[j] = 0;
                } else {
                    arr[j]++;
                }
            }

            // Find largest rectangle in current histogram
            ans = Math.max(ans, rectangle(arr));
        }

        return ans;
    }

    private int rectangle(int[] heights) {
        int n = heights.length;
        Stack<Integer> st = new Stack<>();
        int ans = 0;

        for (int i = 0; i < n; i++) {

            while (!st.isEmpty() && heights[st.peek()] >= heights[i]) {
                int index = st.pop();

                if (!st.isEmpty()) {
                    ans = Math.max(ans,
                            heights[index] * (i - st.peek() - 1));
                } else {
                    ans = Math.max(ans,
                            heights[index] * i);
                }
            }

            st.push(i);
        }

        while (!st.isEmpty()) {
            int index = st.pop();

            if (!st.isEmpty()) {
                ans = Math.max(ans,
                        heights[index] * (n - st.peek() - 1));
            } else {
                ans = Math.max(ans,
                        heights[index] * n);
            }
        }

        return ans;
    }
}

class Solution {
    public int maximalRectangle(char[][] matrix) {
        if (matrix == null || matrix.length == 0 || matrix[0].length == 0) {
            return 0;
        }

        int m = matrix.length;
        int n = matrix[0].length;

        int[] arr = new int[n];
        int ans = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (matrix[i][j] == '0') {
                    arr[j] = 0;
                } else {
                    arr[j]++;
                }
            }

            ans = Math.max(ans, maxArea(arr));
        }

        return ans;
    }
    private int maxArea(int[] arr) {
        int n = arr.length;

        int[] NSR = new int[n];
        int[] NSL = new int[n];

        Stack<Integer> st = new Stack<>();

        for (int i = 0; i < n; i++) {
            while (!st.isEmpty() && arr[st.peek()] > arr[i]) {
                NSR[st.peek()] = i;
                st.pop();
            }
            st.push(i);
        }

        while (!st.isEmpty()) {
            NSR[st.peek()] = n;
            st.pop();
        }

        for (int i = n - 1; i >= 0; i--) {
            while (!st.isEmpty() && arr[st.peek()] > arr[i]) {
                NSL[st.peek()] = i;
                st.pop();
            }
            st.push(i);
        }
        
        while (!st.isEmpty()) {
            NSL[st.peek()] = -1;
            st.pop();
        }

        int ans = 0;

        for (int i = 0; i < n; i++) {
            ans = Math.max(ans, arr[i] * (NSR[i] - NSL[i] - 1));
        }

        return ans;
    }
}

        
