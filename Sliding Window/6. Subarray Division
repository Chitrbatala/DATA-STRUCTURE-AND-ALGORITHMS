public static int birthday(List<Integer> s, int d, int m) {
    // Write your code here
        int n = s.size();
        
        int sum = 0;
        int count = 0;
        
        for (int i = 0; i < m; i++) {
            sum += s.get(i);
        }
        
        if (sum == d) {
            count++;
        }
        
        for (int i = m; i < n; i++) {
            sum = sum - s.get(i - m) + s.get(i);
            
            if (sum == d) {
                count++;
            }
        }
        
        return count;
    }

}
