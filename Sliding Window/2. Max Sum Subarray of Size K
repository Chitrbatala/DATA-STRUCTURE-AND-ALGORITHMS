class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        int n = arr.length;
        
        int sum = 0;
        
        for (int i = 0; i < k; i++) {
            sum += arr[i];
        }
        
        int maxSum = sum;
        
        for (int i = k; i < n; i++) {
            sum = sum - arr[i - k] + arr[i];
            
            maxSum = Math.max(sum, maxSum);
        }
        
        return maxSum;
        
    }
}

