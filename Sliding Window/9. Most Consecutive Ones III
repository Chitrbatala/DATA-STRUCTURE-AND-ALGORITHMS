class Solution {
    public int longestOnes(int[] nums, int k) {
        int n = nums.length;
        int maxL = 0;

        int l = 0;
        int count = 0;

        for (int r = l; r < n; r++) {
            if (nums[r] == 0) {
                count++;
            }

            while (count > k) {
                if (nums[l] == 0) {
                    count--;
                }
                l++;
            }
            maxL = Math.max(maxL, r - l + 1);
        }
        return maxL;
    }
}


