class Solution {
    public int minSubArrayLen(int target, int[] nums) {
        int n = nums.length;

        int sum = 0;
        int l = 0;

        int minL = Integer.MAX_VALUE;

        for (int r = 0; r < n; r++) {
            sum += nums[r];

            while (sum >= target) {
                minL = Math.min(minL, r - l + 1);
                sum -= nums[l];
                l++;
            } 
        }

        return minL == Integer.MAX_VALUE ? 0 : minL;
    }
}


