class Solution {
    class Row {
        int index;
        int soldiers;

        Row(int index, int soldiers) {
            this.index = index;
            this.soldiers = soldiers;
        }
    }
    public int[] kWeakestRows(int[][] mat, int k) {
        PriorityQueue<Row> maxHeap = new PriorityQueue<>(
            (a, b) -> {
                if (a.soldiers == b.soldiers) {
                    return b.index - a.index;
                }

                return b.soldiers - a.soldiers;
            }
        );

        for (int i = 0; i < mat.length; i++) {
            int soldiers = countSoldiers(mat[i]);

            maxHeap.offer(new Row(i, soldiers));

            if (maxHeap.size() > k) {
                maxHeap.poll();
            }
        }

        int[] ans = new int[k];

        for (int i = k - 1; i >= 0; i--) {
            ans[i] = maxHeap.poll().index;
        }

        return ans;

    }
    private int countSoldiers(int[] row) {
        int l = 0;
        int r = row.length - 1;

        while (l <= r) {
            int mid = l + (r - l) / 2;

            if (row[mid] == 1) {
                l = mid + 1;
            } else {
                r = mid - 1;
            }
        }
        return l;
    }
