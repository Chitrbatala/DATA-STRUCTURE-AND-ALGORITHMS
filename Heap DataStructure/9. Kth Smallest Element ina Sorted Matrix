class Solution {
    class Node {
        int value;
        int row;
        int col;

        public Node(int value, int row, int col) {
            this.value = value;
            this.row = row;
            this.col = col;
        }
    }
    public int kthSmallest(int[][] matrix, int k) {
        int n = matrix.length;

        PriorityQueue<Node> pq = new PriorityQueue<>(
            (a, b) -> a.value - b.value
        );

        for (int i = 0; i < n; i++) {
            pq.offer(new Node(matrix[i][0], i, 0));
        }

        for (int i = 0; i < k; i++) {
            Node curr = pq.poll();

            if (curr.col + 1 < n) {
                pq.offer(new Node(matrix[curr.row][curr.col + 1],
                curr.row,
                curr.col + 1));
            }

            if (i == k - 1) {
                return curr.value;
            }
        }

        return -1;
    }
}

