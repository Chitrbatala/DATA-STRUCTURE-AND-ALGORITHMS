class Solution {
    public boolean isMaxHeap(int[] arr) {
        int n = arr.length;
        
        for (int i = 0; i < n / 2; i++) {
            int lc = 2 * i + 1;
            int rc = 2 * i + 2;
            
            if (arr[i] < arr[lc]) {
                return false;
            }
            
            if (rc < n) {
                if (arr[i] < arr[rc]) {
                    return false;
                }
            }
        }
        return true;
        
    }
}
