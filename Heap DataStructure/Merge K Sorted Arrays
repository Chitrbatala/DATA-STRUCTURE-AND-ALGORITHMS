class Solution {

    static class Node {
        int value;
        int row;
        int col;

        Node(int value, int row, int col) {
            this.value = value;
            this.row = row;
            this.col = col;
        }
    }

    public ArrayList<Integer> mergeArrays(int[][] mat) {

        int m = mat.length;
        int n = mat[0].length;

        PriorityQueue<Node> pq =
            new PriorityQueue<>((a, b) -> a.value - b.value);

        // Put first element of every row into heap
        for (int i = 0; i < m; i++) {
            pq.offer(new Node(mat[i][0], i, 0));
        }

        ArrayList<Integer> result = new ArrayList<>();

        while (!pq.isEmpty()) {

            Node current = pq.poll();

            result.add(current.value);

            int row = current.row;
            int col = current.col;

            // If next element exists in the same row
            if (col + 1 < n) {
                pq.offer(
                    new Node(mat[row][col + 1], row, col + 1)
                );
            }
        }

        return result;
    }
}

