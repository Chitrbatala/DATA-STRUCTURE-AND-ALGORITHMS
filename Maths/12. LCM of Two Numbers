class Solution {
    public int lcm(int a, int b) {
        // code here
        int c = gcd(a, b);
        return (a * b) / c;
    }
    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
