class Solution {
    public ArrayList<Integer> sieve(int n) {
        
        ArrayList<Integer> ans = new ArrayList<>();
        if (n < 2) {
            return ans;
        }
        boolean[] prime = new boolean[n + 1];
        Arrays.fill(prime, true);
        
        prime[0] = false;
        prime[1] = false;
        
        for (int i = 2; i * i <= n; i++) {
            for (int j = i * i; j <= n; j += i) {
                if (prime[j]) {
                    prime[j] = false;
                }
            }
        }
        
        for (int i = 2; i <= n; i++) {
            if (prime[i] == true) {
                ans.add(i);
            }
        }
        return ans;
    }
}
