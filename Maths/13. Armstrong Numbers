class Solution {
    public boolean armstrongNumber(int n) {
        // code here
        int original = n;
        int count = String.valueOf(n).length();
        int sum = 0;
        
        while (n != 0) {
            int digit = n % 10;
            
            sum += (int) Math.pow(digit, count);
            
            n = n / 10;
        }
        return sum == original;
    }
}
