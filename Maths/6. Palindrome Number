class Solution {
    public boolean isPalindrome(int x) {
        String temp = Integer.toString(x);

        int l = 0;
        int h = temp.length() - 1;

        while (l <= h) {
            if (temp.charAt(l) != temp.charAt(h)) {
                return false;
            }
            l++;
            h--;
        }
        return true;
    }
}

