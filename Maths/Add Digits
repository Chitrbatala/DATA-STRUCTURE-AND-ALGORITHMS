class Solution {
    public int addDigits(int num) {
        if (num == 0) return 0;

        if (num % 9 == 0) {
            return 9;
        }

        return num % 9;
    }
}
class Solution {
    public int addDigits(int num) {
        while (num >= 10) {
            int ans = 0;
            while (num > 0) {
                ans += num % 10;
                num /= 10;
            }
            num = ans;
        }
        return num;
    }
}
